# Deployment settings for the Data Breach Form solution.
# Copy this file to .env (which is gitignored) and fill in your own values.
# Values are baked in at build time, so rebuild after any change.
# One KEY=value per line. No inline comments after a value.
#
# Do NOT put API keys here. They would end up inside the .sppkg package.
# Enter keys in each web part's property pane instead.

# ── Organisation ─────────────────────────────────────────────────────────────
# Shown in the header and footer of notification emails. Leave blank to omit it.
ORG_NAME=Example Council

# Team that handles breach reports, shown as "<name> (on behalf of <TEAM_NAME>)"
# in the communication log and PDF. Defaults to "Data Breach Notification Team".
TEAM_NAME=Data Breach Notification Team

# Team named in the pre-filled "Reason for decision" wording. Defaults to TEAM_NAME.
REVIEW_TEAM_NAME=Information Governance Team

# Central team mailbox. Receives new-report notifications and every case-closed
# notice, and is the fallback reply address. Required.
ADMIN_NOTIFICATION_EMAIL=data.breach@example.gov.uk

# ── SharePoint ───────────────────────────────────────────────────────────────
# The site hosting the list. Only used to open the workbench on `gulp serve`.
SP_SITE_URL=https://yourtenant.sharepoint.com/sites/DataBreach

# Display name of the SharePoint list reports are stored in.
SP_LIST_NAME=Data Breaches

# Comma-separated SharePoint group names. Exact match, case-sensitive.
SP_ADMIN_GROUPS=Data Breach Owners
SP_REVIEWER_GROUPS=Data Breach Reviewers

# Production form page. Linked from the warning banner shown when TEST_MODE is on.
LIVE_SERVICE_URL=https://yourtenant.sharepoint.com/sites/DataBreach/SitePages/Report-a-data-breach.aspx

# ── Attachments ──────────────────────────────────────────────────────────────
# Per-file size limit on the submission form, in MB. Defaults to 20.
MAX_ATTACHMENT_MB=20

# Comma-separated file extensions the form accepts. Leave blank for the default
# list (PDF, Office documents, text/CSV, Outlook .msg/.eml, common images).
ALLOWED_ATTACHMENT_EXTENSIONS=

# ── Elevated endpoints (APIM URLs for the Logic App operations) ──────────────
# Optional defaults. A URL entered in a web part's property pane takes priority.
SENDMAIL_URL=
APPEND_COMM_LOG_URL=
UPDATE_PANEL_RECOMMENDATIONS_URL=
UPLOAD_ATTACHMENT_URL=
